# Discord Bot Token (required)
# Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Database URL.
# Leave empty for Docker/Coolify: the app builds it from POSTGRES_* below.
# Set this only when running the bot directly on the host or using an external DB.
# Local direct run: postgresql+asyncpg://tmp_vc_bot:change_me@localhost:5432/tmp_vc_bot
# Railway/Heroku: automatically set by Postgres addon
DATABASE_URL=

# Bot runtime options
LOG_LEVEL=INFO

# Slash command sync target.
# Empty = global sync (Discord caches up to 1 hour before commands appear).
# Specify one or more guild IDs (comma-separated) for instant per-guild sync.
# Example for multiple servers:
#   SYNC_GUILD_IDS=111111111111111111,222222222222222222,333333333333333333
SYNC_GUILD_IDS=
# Backward-compatible single guild ID. Prefer SYNC_GUILD_IDS for new deployments.
SYNC_GUILD_ID=

# Database connection options
DATABASE_REQUIRE_SSL=false
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1

# Coolify docker-compose.yml options
# Set these in Coolify's environment variables, not in git.
POSTGRES_USER=tmp_vc_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tmp_vc_bot
POSTGRES_HOST=db
POSTGRES_PORT=127.0.0.1:5432
POSTGRES_MEM_LIMIT=160m
POSTGRES_MEMSWAP_LIMIT=160m
POSTGRES_SHM_SIZE=32mb
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_SHARED_BUFFERS=16MB
POSTGRES_EFFECTIVE_CACHE_SIZE=64MB
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
POSTGRES_WAL_BUFFERS=1MB
POSTGRES_AUTOVACUUM_MAX_WORKERS=1
BOT_MEM_LIMIT=192m
BOT_MEMSWAP_LIMIT=192m
